generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  password          String
  refreshToken      String?
  isVerified        Boolean   @default(false)
  verifyCode        String?
  verifyExpiry      DateTime?
  resetCode         String?
  resetExpiry       DateTime?
  onboardingDone    Boolean   @default(false)
  studyLevel        String?
  codingLevel       String?
  languages         String?
  learningGoal      String?
  challenges        String?
  learnStyle        String?
  studyTime         String?
  xp                Int       @default(0)
  level             Int       @default(1)
  createdAt         DateTime  @default(now())

  courses           Course[]
}

model Course {
  id        String   @id @default(uuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}